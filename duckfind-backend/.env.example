NODE_ENV=development
PORT=3000

# Matches the Postgres service in docker-compose.yml
DATABASE_URL=postgres://duckfind:duckfind@localhost:5432/duckfind

# Comma-separated list of origins allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Secret for signing JWTs (at least 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# MongoDB for scraped companies/jobs (matches the mongo service in docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=duckfind
# How often the scraper re-runs when started without --once
SCRAPE_INTERVAL_HOURS=24
